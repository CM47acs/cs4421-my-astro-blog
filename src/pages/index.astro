---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'My Astro Blog';
const description = 'A personal blog with thoughts, reviews, and recent posts.';
const permalink = Astro.site.href;
const recentPosts = (await getCollection('posts'))
  .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf())
  .slice(0, 3);
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="home-content">
    <section class="home-container" aria-labelledby="welcome-heading">
      <div class="hero-image-container">
        <img class="hero-image" alt="Batman standing in the rain" src="/assets/blog/batmanAURA.jpg" width="500" height="266">
      </div>

      <div class="home-panel">
        <div class="home-copy">
          <h1 id="welcome-heading">Welcome to my opinion storage blog</h1>
          <p><a href="/about/">Learn a bit about this blog</a>.</p>
        </div>

        <section class="recent-posts" aria-labelledby="recent-posts-heading">
          <h2 id="recent-posts-heading">Recent posts</h2>
          {recentPosts.length > 0 ? (
            <ul>
              {recentPosts.map((post) => (
                <li>
                  {post.data.thumbnail && (
                    <a class="recent-post-thumbnail" href={`/blog/${post.data.slug}/`} tabindex="-1" aria-hidden="true">
                      <img src={post.data.thumbnail} alt="" loading="lazy" />
                    </a>
                  )}
                  <div class="recent-post-details">
                    <a href={`/blog/${post.data.slug}/`}>{post.data.title}</a>
                    <time>{post.data.publishDate}</time>
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p>No posts published yet.</p>
          )}
          <a class="all-posts-link" href="/blog/">Browse all posts</a>
        </section>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-content {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .home-container {
    align-items: stretch;
    display: grid;
    flex: 0 0 auto;
    gap: clamp(1em, 3vw, 2.5em);
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    height: clamp(220px, 38vh, 360px);
    margin: 0;
  }

  .hero-image-container {
    min-height: 0;
    overflow: hidden;
  }

  .hero-image {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: center;
    width: 100%;
  }

  .home-copy h1 {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 700;
    margin-bottom: 0.35em;
    line-height: 1.3;
  }

  .home-copy p {
    font-size: 1.15em;
    margin: 0.5em 0 0.75em;
  }

  .home-panel {
    align-self: center;
    padding: 1em 1em 1em 0;
    width: 100%;
  }

  .all-posts-link {
    display: inline-block;
    font-family: var(--font-family-sans);
    font-weight: 700;
  }

  .recent-posts {
    border-top: 1px solid var(--text-secondary);
    margin-top: 1em;
    padding-top: 0.5em;
    width: 100%;
  }

  .recent-posts h2 {
    font-size: 1.4em;
    margin: 0;
  }

  .recent-posts ul {
    list-style: none;
    padding: 0;
    margin: 0.25em 0;
  }

  .recent-posts li {
    align-items: center;
    display: flex;
    gap: 0.65em;
    margin: 0.3em 0;
  }

  .recent-post-thumbnail {
    flex: 0 0 72px;
    height: 45px;
  }

  .recent-post-thumbnail img {
    border-radius: 4px;
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .recent-post-details {
    align-items: baseline;
    display: flex;
    flex: 1;
    gap: 1em;
    justify-content: space-between;
  }

  .recent-posts li a {
    font-family: var(--font-family-sans);
    font-size: 0.95em;
    font-weight: 700;
  }

  .recent-posts time {
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .all-posts-link {
    margin-top: 0.25em;
  }

  @media (max-width: 800px) {
    .home-container {
      gap: 1.25em;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      height: clamp(200px, 34vh, 300px);
    }

    .home-panel {
      padding: 1em 0.5em 1em 0;
    }

    .home-copy h1 {
      font-size: clamp(1.75rem, 5vw, 2.5rem);
    }

    .recent-post-details {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.1em;
    }
  }

  @media (max-width: 480px) {
    .home-container {
      display: flex;
      flex-direction: column;
      gap: 0;
      height: auto;
    }

    .hero-image-container {
      height: clamp(130px, 20vh, 200px);
      flex: 0 0 auto;
    }

    .home-panel {
      align-self: stretch;
      padding: 0.75em 0 0;
    }

    .recent-post-thumbnail {
      flex-basis: 76px;
      height: 52px;
    }
  }
</style>
