---
import { getCollection, render } from 'astro:content'
import readingTime from 'reading-time'
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bio from '../../components/Bio.astro';

const slug = Astro.params.slug;
const posts = await getCollection('posts');
const post = posts.find((entry) => entry.data.slug === slug);

if (!post) {
  Astro.response.status = 404;
}

const title = post?.data.title ?? 'Post not found';
const description = post?.data.description ?? 'The requested blog post could not be found.';
const publishDate = post?.data.publishDate;
const readingTimeEstimate = post ? readingTime(post.body).text : '';
const permalink = `${Astro.site.href}blog/${slug ?? ''}`;
const Content = post ? (await render(post)).Content : undefined;
---

<BaseLayout title={title} description={description} permalink={permalink} current="blog">
  {post && Content ? (
    <>
      <header>
        <p>{publishDate} ~ {readingTimeEstimate}</p>
        <h1>{title}</h1>
        <hr />
      </header>
      <div class="container">
        <article class="content">
          <Content />
        </article>
        <hr />
        <Bio />
      </div>
    </>
  ) : (
    <div class="container">
      <h1>Post not found</h1>
      <p>That blog post could not be found.</p>
    </div>
  )}
</BaseLayout>

<style>
  header {
    text-align: center;
  }

  header h1 {
    margin-bottom: 0.7em;
  }

  header p {
    color: var(--text-secondary);
    text-transform: uppercase;
    font-family: var(--font-family-sans);
    font-weight: 600;
  }

  header hr {
    min-width: 100px;
    width: 30%;
  }
</style>
