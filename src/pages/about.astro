---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About';
const description = 'About this blog.';
const permalink = `${Astro.site.href}about`;
---

<BaseLayout title={title} description={description} permalink={permalink} current="about">
  <div class="container">
    <h1>Welcome to my awesome blog</h1>
    <figure class="about-image">
      <img src="/assets/blog/thumbup.png" alt="Blue guy thumbs up" />
    </figure>
    <p>This is my for fun not serious blog, thanks for reading! </p>
    <p>I am not an expert, in anything at all, nor a writer to be honest, I'm just like having opinions on things.</p>
    <p>This will probably be all about Survivor but I might write about other stuff too.</p>
  </div>
</BaseLayout>

<style>
  .about-image {
    float: right;
    margin: -3em -7em 2em 2em;
    max-width: 300px;
  }

  .about-image img {
    border-radius: 8px;
    margin-bottom: 1.5em;
  }

  @media (max-width: 1020px) {
    .about-image {
      float: none;
      margin: 0 auto 2em;
    }
  }
</style>
